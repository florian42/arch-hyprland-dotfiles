// -*- mode: jsonc -*-
// Started by hyprbar.py, one instance per monitor with "output" filled in.
// Don't run plain `waybar`: without hyprbar the bar stays hidden and the
// workspace buttons have no data.
{
    "position": "left",
    "layer": "overlay",          // also shows over fullscreen windows
    "exclusive": false,          // floats over windows, so revealing it never reflows them
    "start_hidden": true,
    "on-sigusr1": "show",        // hyprbar sends SIGUSR1 to show, SIGUSR2 to hide
    "on-sigusr2": "hide",
    "reload_style_on_change": true,
    "width": 40,
    "margin-top": 6,
    "margin-bottom": 6,
    "margin-left": 6,
    "spacing": 2,

    // Clock and workspaces sit near the hot corner, so the most-used part is the shortest move.
    "modules-left": [
        "clock",
        "custom/ws1", "custom/ws2", "custom/ws3",
        "custom/ws4", "custom/ws5", "custom/ws6"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "hyprland/language",
        "battery",
        "custom/power"
    ],

    "clock": {
        "timezone": "Europe/Berlin",
        "format": "{:%H\n%M}",
        "format-alt": "{:%d\n%m}",
        "justify": "center",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "weeks":    "<span color='#6c7086'>{}</span>",
                "weekdays": "<span color='#a6adc8'>{}</span>",
                "today":    "<span color='#89b4fa'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up",
            "on-click-right": "shift_reset"
        }
    },

    // Fed by hyprbar.py: it writes $XDG_RUNTIME_DIR/hyprbar/ws/N.json, then sends SIGRTMIN+8.
    // The click uses the Lua dispatcher syntax that waybar 0.15's own module lacks.
    "custom/ws1": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/1.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'" },
    "custom/ws2": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/2.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'" },
    "custom/ws3": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/3.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'" },
    "custom/ws4": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/4.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'" },
    "custom/ws5": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/5.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'" },
    "custom/ws6": { "exec": "cat \"$XDG_RUNTIME_DIR/hyprbar/ws/6.json\"", "return-type": "json", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'" },

    // Each status module is an icon over a small number. The bar width is fixed,
    // so going from 9% to 100% doesn't make it grow.
    "pulseaudio": {
        "format": "{icon}\n<small>{volume}</small>",
        "format-bluetooth": "{icon}\n<small>{volume}</small>",
        "format-muted": "󰝟",
        "format-bluetooth-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "hands-free": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "justify": "center",
        "scroll-step": 2,
        "tooltip-format": "{desc} · {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
        "format": "{icon}\n<small>{percent}</small>",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "justify": "center",
        "scroll-step": 5,
        "tooltip-format": "Brightness {percent}%"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "on-click": "kitty --class=Impala -e impala"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "hyprland/language": {
        "format": "{}",
        "format-de": "de",
        "format-us": "us",
        "on-click": "hyprctl switchxkblayout all next"
    },
    "battery": {
        "format": "{icon}\n<small>{capacity}</small>",
        "format-full": "󰂅",
        "format-plugged": "󰚥",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default":  ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "justify": "center",
        "full-at": 80,
        "interval": 10,
        "states": { "warning": 20, "critical": 10 },
        "tooltip-format": "{capacity}% · {timeTo}",
        "tooltip-format-charging": "{capacity}% · {power:.1f} W ↑ · {timeTo}",
        "tooltip-format-discharging": "{capacity}% · {power:.1f} W ↓ · {timeTo}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/power-menu.sh"
    }
}
